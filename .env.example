# Copia a .env. Nunca se versiona.

PORT=3107
NODE_ENV=development

# Postgres del docker-compose (puerto 5447 según 00-base/PLANTILLA.md).
DATABASE_URL=postgresql://postgres:postgres@localhost:5447/aichat

# Genera cada uno con: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# El frontend de este proyecto.
CORS_ORIGINS=http://localhost:5107

# Qué modelo contesta.
#   echo      — inventa la respuesta sin salir del proceso. No cuesta nada.
#   anthropic — el de verdad. Exige ANTHROPIC_API_KEY.
# La demostración pública corre con echo a propósito: un chat abierto contra un
# modelo que se cobra por token es una factura esperando a que alguien la
# encuentre.
MODEL_PROVIDER=echo
ANTHROPIC_API_KEY=
# Milisegundos entre pedazos del proveedor falso. Sube para ver el stream lento.
ECHO_CHUNK_MS=18

# Tope de gasto por usuario y mes, en centavos de dólar.
USAGE_LIMIT_CENTS=200

# Dónde caen los archivos adjuntos. En el VPS es un volumen de Docker; en
# desarrollo, una carpeta del repo que .gitignore ya ignora.
UPLOADS_DIR=./data/uploads
UPLOAD_RATE_LIMIT_MAX=20

RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
CHAT_RATE_LIMIT_MAX=20
DEMO_RATE_LIMIT_MAX=40

# Detrás de nginx, el IP del cliente llega en X-Forwarded-For con un salto.
TRUST_PROXY_HOPS=0

# Entrega sesiones sin contraseña. Solo en la caja de demostración.
DEMO_MODE=true
